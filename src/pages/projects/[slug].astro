---
import { ArrowLeft, ArrowRight, ExternalLink, Github } from "lucide-react";
import Footer from "@/components/Footer";
import Header from "@/components/Header";
import SkipLink from "@/components/SkipLink";
import WritingBreadcrumbs from "@/components/WritingBreadcrumbs.astro";
import { projects, type PortfolioProject } from "@/content/portfolio";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { breadcrumbStructuredData } from "@/lib/breadcrumbs";

interface Props {
  readonly project: PortfolioProject;
}

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.page.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const canonicalPath = `/projects/${project.page.slug}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const pageTitle = `${project.title} | Michael Rico`;
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/#projects" },
  { name: project.page.name, path: canonicalPath },
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareSourceCode",
      "@id": `${canonicalUrl}#project`,
      name: project.page.name,
      headline: project.title,
      description: project.description,
      url: canonicalUrl,
      codeRepository: project.links.repository.href,
      author: {
        "@type": "Person",
        "@id": "https://ricomanifesto.com/#michael-rico",
        name: "Michael Rico",
        url: "https://ricomanifesto.com/",
      },
      programmingLanguage: project.page.programmingLanguages,
    },
    breadcrumbStructuredData(breadcrumbs),
  ],
};
---

<SiteLayout
  title={pageTitle}
  description={project.page.metaDescription}
  canonicalPath={canonicalPath}
  pageType="article"
  imagePath={project.image?.src ?? "/images/social-card.png"}
  imageAlt={`${project.page.name} project preview`}
  structuredData={structuredData}
>
  <div class="writing-page-shell project-page-shell">
    <SkipLink />
    <Header currentPath={canonicalPath} currentNavHref="/#projects" />
    <main id="main-content" tabindex="-1" class="project-page-main">
      <article class="project-detail">
        <WritingBreadcrumbs items={breadcrumbs} />
        <header class="project-detail-header">
          <p class="project-detail-eyebrow">{project.page.name} case study</p>
          <h1>{project.title}</h1>
          <p class="project-detail-description">{project.description}</p>
          <ul class="project-detail-tech" aria-label="Technologies">
            {project.page.techStack.map((technology) => <li>{technology}</li>)}
          </ul>
        </header>

        {project.image && (
          <div class="project-detail-media">
            <img
              src={project.image.src}
              width={project.image.width}
              height={project.image.height}
              alt={`${project.page.name} project interface`}
              loading="eager"
              decoding="async"
            />
          </div>
        )}

        <div class="project-detail-actions">
          <a
            href={project.links.repository.href}
            target="_blank"
            rel="noopener noreferrer"
            class="project-detail-action"
          >
            <Github size={19} aria-hidden="true" focusable="false" />
            View repository
          </a>
          {project.links.demo && (
            <a
              href={project.links.demo.href}
              target="_blank"
              rel="noopener noreferrer"
              class="project-detail-action"
            >
              <ExternalLink size={19} aria-hidden="true" focusable="false" />
              View live project
            </a>
          )}
        </div>

        <section aria-labelledby="project-evidence-heading" class="project-detail-evidence">
          <h2 id="project-evidence-heading">Inspect the evidence</h2>
          <a
            href={project.page.evidence.href}
            target={project.page.evidence.external ? "_blank" : undefined}
            rel={project.page.evidence.external ? "noopener noreferrer" : undefined}
            aria-label={`Inspect ${project.page.name} evidence`}
            class="project-evidence-link"
          >
            {project.page.evidence.label}
            <ArrowRight size={18} aria-hidden="true" focusable="false" />
          </a>
        </section>

        <nav aria-label="Project navigation" class="project-detail-back">
          <a href="/#projects">
            <ArrowLeft size={18} aria-hidden="true" focusable="false" />
            All projects
          </a>
        </nav>
      </article>
    </main>
    <Footer />
  </div>
</SiteLayout>
