---
import Footer from "@/components/Footer";
import Header from "@/components/Header";
import SkipLink from "@/components/SkipLink";
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout
  title="Privacy | Michael Rico"
  description="Rico Manifesto does not run analytics or track visitors. Details on the Security & GRC Notes newsletter, hosting, and external links."
  canonicalPath="/privacy/"
>
  <div class="writing-page-shell">
    <SkipLink />
    <Header currentPath="/privacy/" />
    <main id="main-content" tabindex="-1" class="writing-article-main">
      <article class="writing-article">
        <header class="writing-article-header">
          <p class="writing-eyebrow">Site information</p>
          <h1>Privacy</h1>
          <p class="writing-article-description">
            I don't run analytics or track visitors on this site.
          </p>
        </header>

        <div class="writing-prose">
          <h2>Newsletter</h2>
          <p>
            If you subscribe to Security &amp; GRC Notes at <a href="https://newsletter.ricomanifesto.com/">newsletter.ricomanifesto.com</a>, only your email address, subscription state, and delivery status events are stored. Issues do not use open-tracking pixels or click trackers, and you can unsubscribe in one click from any email.
          </p>
          <p>
            Read the full details on storage, services involved, retention, and deletion in the <a href="https://newsletter.ricomanifesto.com/privacy/">newsletter privacy notice</a>.
          </p>

          <h2>Hosting and external links</h2>
          <p>
            The services that host and deliver this site handle requests under their own policies. If you follow a link to another website or email me, that service's privacy policy applies.
          </p>
        </div>
      </article>
    </main>
    <Footer />
  </div>
</SiteLayout>
