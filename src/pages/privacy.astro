---
import Footer from "@/components/Footer";
import Header from "@/components/Header";
import SkipLink from "@/components/SkipLink";
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout
  title="Privacy | Michael Rico"
  description="Information about visitor analytics, hosting, external links, and the Security & GRC Notes newsletter on Rico Manifesto."
  canonicalPath="/privacy/"
>
  <div class="writing-page-shell">
    <SkipLink />
    <Header currentPath="/privacy/" />
    <main id="main-content" tabindex="-1" class="writing-article-main">
      <article class="writing-article">
        <header class="writing-article-header">
          <p class="writing-eyebrow">Site information</p>
          <h1>Privacy</h1>
          <p class="writing-article-description">
            This site does not load a visitor analytics beacon.
          </p>
        </header>

        <div class="writing-prose">
          <h2>Visitor analytics</h2>
          <p>
            The manually loaded Cloudflare Web Analytics script has been removed. The site does not send custom analytics events, advertising identifiers, form entries, or contact-link activity.
          </p>

          <h2>Hosting and external services</h2>
          <p>
            Hosting and other services used to deliver this site may process requests under their own policies. This page does not describe their logging or retention practices.
          </p>

          <h2>External links</h2>
          <p>
            Links to other websites and contact services are governed by those services' privacy policies.
          </p>

          <h2>Newsletter</h2>
          <p>
            If you subscribe to Security &amp; GRC Notes at <a href="https://newsletter.ricomanifesto.com/">newsletter.ricomanifesto.com</a>, only your email address, subscription state, and delivery status events are stored. Issues do not use open-tracking pixels or click trackers, and you can unsubscribe in one click from any email.
          </p>
          <p>
            Read the full details on storage, services involved, retention, and deletion in the <a href="https://newsletter.ricomanifesto.com/privacy/">newsletter privacy notice</a>.
          </p>
        </div>
      </article>
    </main>
    <Footer />
  </div>
</SiteLayout>
