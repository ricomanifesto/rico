{
    "name": "ricomanifesto",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "homepage": "https://ricomanifesto.com",
    "scripts": {
      "dev": "vite",
      "build": "tsc && vite build",
      "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
      "a11y": "node scripts/check-source-accessibility.mjs",
      "images": "node scripts/check-source-images.mjs",
      "nav": "node scripts/check-source-navigation.mjs",
      "workflow": "node scripts/check-source-workflow.mjs",
      "browser": "playwright test",
      "smoke": "node scripts/check-build-output.mjs",
      "check": "npm run lint && npm run a11y && npm run images && npm run nav && npm run workflow && npm run browser && npm run build && npm run smoke",
      "preview": "vite preview",
      "predeploy": "npm run check",
      "deploy": "gh-pages -d dist"
    },
    "dependencies": {
      "framer-motion": "^10.16.4",
      "lucide-react": "^0.263.0",
      "react": "^18.2.0",
      "react-dom": "^18.2.0"
    },
    "devDependencies": {
      "@playwright/test": "^1.61.0",
      "@tailwindcss/typography": "^0.5.9",
      "@types/node": "^20.4.5",
      "@types/react": "^18.2.15",
      "@types/react-dom": "^18.2.7",
      "@typescript-eslint/eslint-plugin": "^6.0.0",
      "@typescript-eslint/parser": "^6.0.0",
      "@vitejs/plugin-react": "^4.0.3",
      "autoprefixer": "^10.4.14",
      "eslint": "^8.45.0",
      "eslint-plugin-react-hooks": "^4.6.0",
      "eslint-plugin-react-refresh": "^0.4.3",
      "gh-pages": "^5.0.0",
      "postcss": "^8.4.27",
      "tailwindcss": "^3.3.3",
      "tailwindcss-animate": "^1.0.6",
      "typescript": "^5.0.2",
      "vite": "^4.4.9"
    }
  }
